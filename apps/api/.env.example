# --- Runtime ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Local dev (embedded postgres or docker-compose): postgres://dayflow:dayflow@127.0.0.1:5433/dayflow
DATABASE_URL=postgres://dayflow:dayflow@127.0.0.1:5433/dayflow
# Hosted database (e.g. Neon pooled connection string). When set, the API,
# migrations, and seeds use this instead of DATABASE_URL.
DB_LIVE_URL=
# Optional: DIRECT (non-pooled) string; migrations prefer this when provided.
DIRECT_DATABASE_URL=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# In development, OTP codes are echoed in API responses and logged instead of emailed.
OTP_DEV_ECHO=true

# --- Mail (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Dayflow <no-reply@dayflow.app>

# --- OAuth ---
GOOGLE_CLIENT_ID=

# --- Files ---
# Attachment storage directory. Defaults to <repo>/.uploads; set this where
# the checkout is read-only (e.g. serverless: /tmp/uploads).
UPLOAD_DIR=

# --- Web ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
