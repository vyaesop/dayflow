<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only: allows plain HTTP to a dev server on the host machine.

  Android 9+ blocks cleartext traffic by default, and the app talks to
  http://10.0.2.2:4000 (the emulator's alias for the host's localhost).
  Only these loopback hosts are exempted, and only in debug builds — release
  builds keep cleartext blocked entirely.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator's alias for the host machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Genymotion's equivalent -->
        <domain includeSubdomains="false">10.0.3.2</domain>
        <!-- A physical device pointed at a host over USB/Wi-Fi via adb reverse -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
