# --- Runtime ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Local dev (embedded postgres or docker-compose): postgres://dayflow:dayflow@127.0.0.1:5433/dayflow
# Neon production: use the POOLED connection string here...
DATABASE_URL=postgres://dayflow:dayflow@127.0.0.1:5433/dayflow
# ...and the DIRECT (non-pooled) string here for migrations.
DIRECT_DATABASE_URL=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# In development, OTP codes are echoed in API responses and logged instead of emailed.
OTP_DEV_ECHO=true

# --- Mail (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Dayflow <no-reply@dayflow.app>

# --- OAuth ---
GOOGLE_CLIENT_ID=

# --- Web ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
